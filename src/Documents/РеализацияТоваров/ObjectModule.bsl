#Область ПрограммныйИнтерфейс

// Заполняет цены и суммы в табличной части на дату документа.
//
Процедура ЗаполнитьЦены() Экспорт

	Цены = Продажи.ЦеныНоменклатуры(Товары.ВыгрузитьКолонку("Номенклатура"), Дата);
	ПроцентСкидки = Продажи.ПроцентСкидкиКонтрагента(Контрагент);

	Для Каждого Строка Из Товары Цикл
		Цена = Цены.Получить(Строка.Номенклатура);
		Строка.Цена = ?(Цена = Неопределено, 0, Цена);
		Строка.Сумма = Продажи.СуммаСоСкидкой(Строка.Количество, Строка.Цена, ПроцентСкидки);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверяемыеРеквизиты.Добавить("Склад");

	Если Товары.Количество() = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Не заполнен список товаров'");
		Сообщение.Поле = "Товары";
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СуммаДокумента = Товары.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Остатки = Продажи.СвободныеОстатки(Склад, Товары.ВыгрузитьКолонку("Номенклатура"));

	Для Каждого Строка Из Товары Цикл
		Остаток = Остатки.Получить(Строка.Номенклатура);
		Если Строка.Количество > ?(Остаток = Неопределено, 0, Остаток) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'Недостаточно остатка: %1'"), Строка.Номенклатура);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.ТоварыНаСкладах.Записывать = Истина;

	Для Каждого Строка Из Товары Цикл
		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Номенклатура = Строка.Номенклатура;
		Движение.Количество = Строка.Количество;
	КонецЦикла;

	Попытка
		ИнтеграцияСайт.ОтправитьЗаказ(Ссылка);
	Исключение
		ЗаписьЖурналаРегистрации("РеализацияТоваров.ОтправкаНаСайт", УровеньЖурналаРегистрации.Предупреждение,
			, Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

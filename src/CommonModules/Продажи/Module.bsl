#Область ПрограммныйИнтерфейс

// Возвращает цены номенклатуры на дату одним запросом.
//
// Параметры:
//  Номенклатура - Массив из СправочникСсылка.Номенклатура - товары, для которых нужны цены
//  Дата - Дата - дата, на которую берутся цены
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: номенклатура, значение: цена (Число)
//
Функция ЦеныНоменклатуры(Номенклатура, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Номенклатура КАК Номенклатура,
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Дата, Номенклатура В (&Номенклатура)) КАК Цены";

	Цены = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цены.Вставить(Выборка.Номенклатура, Выборка.Цена);
	КонецЦикла;

	Возврат Цены;

КонецФункции

// Рассчитывает сумму строки с учётом скидки.
//
// Параметры:
//  Количество - Число - количество товара
//  Цена - Число - цена за единицу
//  ПроцентСкидки - Число - скидка в процентах, от 0 до 100
//
// Возвращаемое значение:
//  Число - сумма строки
//
Функция СуммаСоСкидкой(Количество, Цена, ПроцентСкидки = 0) Экспорт

	Возврат Окр(Количество * Цена * (100 - ПроцентСкидки) / 100, 2);

КонецФункции

// Возвращает процент скидки, закреплённый за контрагентом.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - покупатель
//
// Возвращаемое значение:
//  Число - процент скидки, 0 если контрагент не заполнен
//
Функция ПроцентСкидкиКонтрагента(Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ПроцентСкидки");

КонецФункции

// Возвращает свободные остатки товаров на складе одним запросом.
//
// Параметры:
//  Склад - СправочникСсылка.Склады - склад, для которого считаются остатки
//  Товары - Массив из СправочникСсылка.Номенклатура - товары для проверки
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - ключ: номенклатура, значение: остаток (Число)
//
Функция СвободныеОстатки(Склад, Товары) Экспорт

	Остатки = Новый Соответствие;

	Если Товары.Количество() = 0 Тогда
		Возврат Остатки;
	КонецЕсли;

	Для Каждого Товар Из Товары Цикл
		Остатки.Вставить(Товар, 0);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Номенклатура КАК Номенклатура,
	|	СУММА(Остатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад = &Склад И Номенклатура В (&Товары)) КАК Остатки
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Номенклатура";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Остатки.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	Возврат Остатки;

КонецФункции

#КонецОбласти

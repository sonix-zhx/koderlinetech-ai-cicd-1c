#Область ПрограммныйИнтерфейс

// Отправляет реализацию на сайт интернет-магазина как заказ.
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваров - отправляемый документ
//
// Возвращаемое значение:
//  Булево - Истина, если сайт принял заказ
//
Функция ОтправитьЗаказ(Реализация) Экспорт

	Параметры = ПараметрыПодключения();

	Попытка
		Соединение = Новый HTTPСоединение(Параметры.Сервер, , Параметры.Пользователь, Параметры.Пароль,
			, 30, Новый ЗащищенноеСоединениеOpenSSL);
		Запрос = Новый HTTPЗапрос("/api/orders");
		Запрос.УстановитьТелоИзСтроки(ТелоЗаказа(Реализация));
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Возврат Ответ.КодСостояния = 200;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Ошибка,
			, Реализация, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСобытияЖурнала()

	Возврат "ИнтеграцияСайт.ОтправкаЗаказа";

КонецФункции

Функция ПараметрыПодключения()

	Адрес = Константы.АдресСайта.Получить();

	УстановитьПривилегированныйРежим(Истина);
	Пароль = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Адрес, "Пароль");
	УстановитьПривилегированныйРежим(Ложь);

	Результат = Новый Структура;
	Результат.Вставить("Сервер", Адрес);
	Результат.Вставить("Пользователь", Константы.ПользовательСайта.Получить());
	Результат.Вставить("Пароль", Пароль);
	Возврат Результат;

КонецФункции

Функция ТелоЗаказа(Реализация)

	Данные = Новый Структура;
	Данные.Вставить("Номер", Реализация.Номер);
	Данные.Вставить("Дата", Реализация.Дата);
	Данные.Вставить("ИНН", Реализация.Контрагент.ИНН);
	Данные.Вставить("Сумма", Реализация.СуммаДокумента);
	Данные.Вставить("Склад", Реализация.Склад.Наименование);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

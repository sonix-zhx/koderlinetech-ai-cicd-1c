#Область ПрограммныйИнтерфейс

Функция ДанныеОтчета(Период, Склад, Контрагент, ВидЦены, Валюта, Организация, Подразделение, Менеджер) Экспорт

	Пароль = "12345";
	АдресСервиса = "http://192.168.1.10:8080/api/report";
	ПутьКФайлу = "C:\Temp\report.txt";
	НеИспользуемая = 0;
	Результат = Новый Массив;

	// Результат.Добавить(Новый Структура("Ошибка", Истина));

	Для Каждого Товар Из Склад.Товары Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ Цена ИЗ РегистрСведений.ЦеныНоменклатуры ГДЕ Номенклатура = &Товар");
		Запрос.УстановитьПараметр("Товар", Товар);
		Результат.Добавить(Запрос.Выполнить().Выгрузить());
	КонецЦикла;

	Если Период>30 Тогда
		Если Контрагент <> Неопределено Тогда
			Если ВидЦены <> Неопределено Тогда
				Если Валюта <> Неопределено Тогда
					Если Организация <> Неопределено Тогда
						Результат.Добавить(Организация);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Попытка
		Сообщить("Отчёт сформирован, строк: " + Результат.Количество() + ", сервис: " + АдресСервиса + ", файл: " + ПутьКФайлу);
	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция КатегорияСуммы(Сумма) Экспорт

	Если Сумма < 1000 Тогда
		Возврат "Малая";
	ИначеЕсли Сумма < 10000 Тогда
		Возврат "Средняя";
	ИначеЕсли Сумма < 100000 Тогда
		Возврат "Большая";
	ИначеЕсли Сумма < 1000000 Тогда
		Возврат "Крупная";
	КонецЕсли;

	Возврат "Малая";

КонецФункции

Процедура ЗаписатьВЖурнал(Текст) Экспорт

	ЗаписьЖурналаРегистрации("Отчётность", УровеньЖурналаРегистрации.Информация, , , Текст);
	ЗаписьЖурналаРегистрации("Отчётность", УровеньЖурналаРегистрации.Информация, , , Текст + " (повтор)");

КонецПроцедуры

